---
// Progress tracker. State lives in this browser's localStorage only.
import { phases } from '../data/sessions';
---
<be-tracker>
  <div class="summary">
    <div class="bar"><div class="fill" data-fill></div></div>
    <p><strong data-done>0</strong> / 100 sessions done · current streak <strong data-streak>0</strong></p>
    <p class="hint">Click a session to cycle: not started → in progress → done. Saved in this browser only.</p>
  </div>
  {phases.map((p) => (
    <div class="phase">
      <h3>Phase {p.id}: {p.title}</h3>
      <div class="grid">
        {p.sessions.map((s) => (
          <button type="button" class:list={['cell', { review: s.review, milestone: s.milestone }]} data-n={s.n} title={`S${s.n}: ${s.title}`}>
            <span class="n">{s.n}</span>
            <span class="t">{s.title}</span>
          </button>
        ))}
      </div>
    </div>
  ))}
  <p class="actions"><button type="button" data-reset class="reset">Reset progress</button></p>
</be-tracker>

<script>
  const KEY = 'be-course-progress-v1';
  type State = Record<string, { s: 0 | 1 | 2; at?: string }>;
  const load = (): State => { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } };
  const save = (st: State) => { try { localStorage.setItem(KEY, JSON.stringify(st)); } catch {} };

  class Tracker extends HTMLElement {
    connectedCallback() {
      const st = load();
      const cells = [...this.querySelectorAll<HTMLButtonElement>('.cell')];
      const render = () => {
        let done = 0;
        for (const c of cells) {
          const v = st[c.dataset.n!]?.s ?? 0;
          c.dataset.state = String(v);
          if (v === 2) done++;
        }
        // streak = consecutive done sessions from S1
        let streak = 0;
        while (st[String(streak + 1)]?.s === 2) streak++;
        this.querySelector('[data-done]')!.textContent = String(done);
        this.querySelector('[data-streak]')!.textContent = String(streak);
        (this.querySelector('[data-fill]') as HTMLElement).style.width = `${done}%`;
      };
      cells.forEach((c) => c.addEventListener('click', () => {
        const n = c.dataset.n!;
        const next = (((st[n]?.s ?? 0) + 1) % 3) as 0 | 1 | 2;
        st[n] = { s: next, at: new Date().toISOString() };
        save(st); render();
      }));
      this.querySelector('[data-reset]')!.addEventListener('click', () => {
        if (!confirm('Reset all progress in this browser?')) return;
        for (const k of Object.keys(st)) delete st[k];
        save(st); render();
      });
      render();
    }
  }
  customElements.define('be-tracker', Tracker);
</script>

<style>
  .bar { height: 12px; border-radius: 999px; background: var(--sl-color-gray-5); overflow: hidden; }
  .fill { height: 100%; width: 0; background: var(--sl-color-accent); transition: width .3s; }
  .hint { font-size: .85rem; color: var(--sl-color-gray-3); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr)); gap: .4rem; }
  .cell { all: unset; box-sizing: border-box; cursor: pointer; display: flex; gap: .45rem; align-items: baseline; padding: .45rem .55rem; border: 1px solid var(--sl-color-gray-5); border-radius: 8px; font-size: .78rem; line-height: 1.2; color: var(--sl-color-gray-2); }
  .cell:hover { border-color: var(--sl-color-accent); }
  .cell:focus-visible { outline: 2px solid var(--sl-color-accent); }
  .cell .n { font-weight: 700; font-variant-numeric: tabular-nums; color: var(--sl-color-white); }
  .cell.review { border-style: dashed; }
  .cell.milestone .n::after { content: ' 🏁'; }
  .cell[data-state='1'] { border-color: var(--sl-color-orange); background: color-mix(in srgb, var(--sl-color-orange) 12%, transparent); }
  .cell[data-state='2'] { border-color: var(--sl-color-green); background: color-mix(in srgb, var(--sl-color-green) 16%, transparent); }
  .cell[data-state='2'] .n::before { content: '✓ '; color: var(--sl-color-green); }
  .reset { all: unset; cursor: pointer; font-size: .8rem; color: var(--sl-color-gray-3); text-decoration: underline; }
  .phase h3 { margin-top: 1.5rem; }
</style>
